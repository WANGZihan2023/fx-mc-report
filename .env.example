# 复制为仓库根目录 .env（已 gitignore）。
# 本机 Streamlit：API 配置页「保存到本机 .env」会写入本文件 + vault。
# Railway 公网站：点「保存」只写服务器临时盘，不会到你的 Mac——请用 Variables，或「下载 .env」。
# 共享 vault：/Users/wangzihan/Desktop/工作_汇率/fx_data_apis/.env
# 勿提交真实 Key。

# --- 推荐 ---
FRED_API_KEY=
NEWSAPI_KEY=
FINNHUB_API_KEY=

# --- 可选行情增强 ---
ALPHA_VANTAGE_API_KEY=
